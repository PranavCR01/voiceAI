# Audio never enters the repo (see CLAUDE.md rule 1)
*.wav
*.mp3
*.flac
*.webm
*.opus
*.ogg
*.mulaw
*.ulaw
data/raw/
data/cache/
# Run results: only run.json + results.parquet are tracked (re-scoring without new API spend);
# raw provider responses stay local (they carry request ids). See docs/DECISIONS.md 2026-11-04.
results/**
!results/*/
!results/*/run.json
!results/*/results.parquet
# Repeat runs of a config (run-to-run noise), kept apart because a report takes one run per config.
results_retest/**
!results_retest/*/
!results_retest/*/run.json
!results_retest/*/results.parquet
# Runs replaced by a re-run under the same config id (e.g. a changed boost list). See docs/DECISIONS.md 2026-11-05.
results_superseded/**
!results_superseded/*/
!results_superseded/*/run.json
!results_superseded/*/results.parquet
# Runs on augmented manifests, one directory per recipe (harness/augment/README.md).
results_augmented/**
!results_augmented/*/
!results_augmented/*/*/
!results_augmented/*/*/run.json
!results_augmented/*/*/results.parquet

# Streaming latency runs and endpointing sweeps: run.json + results.parquet + slim traces
# (no provider payloads, gzipped; `python -m harness.streaming.slim`). Full traces stay local.
results_stream/**
!results_stream/*/
!results_stream/*/run.json
!results_stream/*/results.parquet
!results_stream/*/traces/
!results_stream/*/traces/*.jsonl.gz
results_sweeps/**
!results_sweeps/*/
!results_sweeps/*/run.json
!results_sweeps/*/results.parquet
!results_sweeps/*/traces/
!results_sweeps/*/traces/*.jsonl.gz
# Trial runs are never committed.
results_stream_trial/
results_sweeps_trial/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Secrets
.env
.env.*
!.env.example
